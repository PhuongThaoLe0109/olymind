// OlymMind — schema Prisma (PostgreSQL)
// Chạy: npx prisma db push

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Category {
  SU
  DIA
  VAN
  TOAN
  LY
  HOA_SINH
  ANH
  CHUNG
}

enum RoundType {
  KHOI_DONG
  VUOT_CHUONG_NGAI_VAT
  TANG_TOC
  VE_DICH
}

enum QuestionType {
  TEXT
  IMAGE
  SEQUENCE
  LOGIC
  MULTIPLE_CHOICE
}

enum MatchStatus {
  WAITING
  PLAYING
  FINISHED
  ABANDONED
}

enum QuestionSource {
  MANUAL
  AI
  IMPORT
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String?  @unique
  avatar    String?
  eloRating Int      @default(1000)
  createdAt DateTime @default(now())

  participations MatchParticipant[]
  submissions    Submission[]
  mistakes       UserMistake[]
}

model Question {
  id            String         @id @default(cuid())
  content       String
  mediaUrl      String?
  type          QuestionType   @default(TEXT)
  round         RoundType
  category      Category
  options       Json? // dùng cho câu trắc nghiệm / sắp xếp sự kiện
  correctAnswer String
  acceptedAnswers String[]     @default([]) // các cách viết khác được chấp nhận
  explanation   String
  trivia        String?
  difficulty    Int            @default(2) // 1–5
  timeLimit     Int            @default(15) // giây
  points        Int            @default(10)
  source        QuestionSource @default(MANUAL)
  verified      Boolean        @default(false) // câu AI sinh phải được duyệt trước khi vào ngân hàng chính thức
  contentHash   String         @unique // chống trùng lặp
  seed          String?
  createdAt     DateTime       @default(now())

  submissions Submission[]
  mistakes    UserMistake[]

  @@index([round, category])
}

model Match {
  id         String      @id @default(cuid())
  code       String      @unique // mã phòng 5 ký tự
  status     MatchStatus @default(WAITING)
  seed       String?
  questionIds String[]   @default([]) // thứ tự câu hỏi (phục vụ Rematch)
  createdAt  DateTime    @default(now())
  finishedAt DateTime?

  participants MatchParticipant[]
  submissions  Submission[]
  history      MatchHistory?
}

model MatchParticipant {
  id         String @id @default(cuid())
  matchId    String
  userId     String?
  displayName String
  seat       Int // 1–4
  finalScore Int    @default(0)
  placement  Int?

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user  User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([matchId, seat])
}

model Submission {
  id            String   @id @default(cuid())
  matchId       String?
  userId        String?
  questionId    String
  answer        String
  isCorrect     Boolean
  responseMs    Int? // thời gian từ lúc hiện câu hỏi đến lúc trả lời
  pointsAwarded Int      @default(0)
  createdAt     DateTime @default(now())

  match    Match?   @relation(fields: [matchId], references: [id], onDelete: SetNull)
  user     User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// Sổ tay câu sai — ôn tập theo hộp Leitner (spaced repetition)
model UserMistake {
  id           String   @id @default(cuid())
  userId       String
  questionId   String
  wrongCount   Int      @default(1)
  box          Int      @default(1) // 1–5; đúng thì lên hộp, sai thì về hộp 1
  nextReviewAt DateTime @default(now())
  lastWrongAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
  @@index([userId, nextReviewAt])
}

// Nhật ký toàn bộ trận đấu — phục vụ Replay và Match Review
model MatchHistory {
  id            String   @id @default(cuid())
  matchId       String   @unique
  events        Json // chuỗi sự kiện có mốc thời gian (bấm chuông, trả lời, điểm...)
  scoreTimeline Json // biến động điểm sau từng câu
  questionSnapshot Json // bản sao câu hỏi tại thời điểm thi đấu
  createdAt     DateTime @default(now())

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
}
